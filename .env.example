# Salin menjadi .env lalu isi. JANGAN commit .env.
# Dipakai mulai Tahap 2 (login). Wajib BERBEDA dari BA Ukur. Buat dengan: openssl rand -base64 48
SESSION_SECRET=
# Isi 1 hanya bila di belakang reverse proxy (Nginx/Caddy).
TRUST_PROXY=
# Isi off untuk mengunci fitur Reset Data di Pengaturan (disarankan setelah aplikasi dipakai sungguhan).
RESET_DATA=
